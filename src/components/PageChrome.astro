---
// Floating WhatsApp button, cookie banner and photo lightbox shared by the public pages.
interface Props { lightbox?: boolean; cookie?: boolean }
const { lightbox = true, cookie = true } = Astro.props;
---
<a class="floating-whatsapp" href="https://wa.me/393493608146" target="_blank" rel="noreferrer" aria-label="Contattaci su WhatsApp" data-floating-whatsapp data-track="floating_whatsapp_click">
  <img src="/assets/whatsapp-icon.svg" alt="" aria-hidden="true" />
</a>

{cookie && (
  <div class="cookie-banner" data-cookie-banner hidden>
    <p data-i18n="cookie.text">Cookie tecnici e preferenze locali. Leggi la Cookie Policy.</p>
    <a href="/cookie" data-i18n="footer.cookie">Cookie Policy</a>
    <button type="button" class="button primary small" data-cookie-accept data-i18n="cookie.accept">Accetta</button>
  </div>
)}

{lightbox && (
  <div class="lightbox" aria-hidden="true" data-lightbox>
    <button class="lightbox-close" type="button" aria-label="Chiudi galleria" data-lightbox-close>×</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="Foto precedente" data-lightbox-prev>‹</button>
    <img src="" alt="" data-lightbox-image />
    <button class="lightbox-nav lightbox-next" type="button" aria-label="Foto successiva" data-lightbox-next>›</button>
  </div>
)}
