---
import { pick, t, url, type Lang } from "../i18n";

import Base from "../layouts/Base.astro";
import HouseTour from "../components/react/HouseTour";
import BookingForm from "../components/react/BookingForm";
import jsonLd from "../data/jsonld/index.json";

interface Props { lang?: Lang }
const { lang = "it" } = Astro.props;
---
<Base
  lang={lang}
  title={t("meta.home.title", lang)}
  description={t("meta.home.description", lang)}
  path="/"
  header="home"
  ogDescription={t("meta.home.ogDescription", lang)}
  ogImage="/assets/og/home.jpg"
  scripts={["vendor/lenis/lenis.min.js", "script.js", "motion.js"]}
  jsonLd={jsonLd}
>
  <main id="home">
      <section id="tour" class="tour-section" aria-labelledby="tour-title">
        <div class="tour-intro visually-hidden">
          <h1 data-i18n="hero.title">{t("hero.title", lang)}</h1>
          <p class="eyebrow" data-i18n="tour.eyebrow">{t("tour.eyebrow", lang)}</p>
          <h2 id="tour-title" data-i18n="tour.title">{t("tour.title", lang)}</h2>
          <p data-i18n="tour.copy">{t("tour.copy", lang)}</p>
        </div>
        <HouseTour client:load lang={lang} dict={pick(["tour.", "homes."])} />
      </section>

      <section id="tour-fine" class="tour-end" aria-labelledby="tour-end-title">
        <div class="tour-end-media" aria-hidden="true">
          <img src="/assets/tour/verde-esterni-05-1280.webp" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="tour-end-inner">
          <h2 id="tour-end-title" data-i18n="tourEnd.title">{t("tourEnd.title", lang)}</h2>
          <div class="tour-end-actions">
            <a class="tour-end-btn tour-end-btn--verde" href="#prenota" data-home-request="La Dimora Verde" data-i18n="tourEnd.verde">{t("tourEnd.verde", lang)}</a>
            <a class="tour-end-btn tour-end-btn--blu" href="#prenota" data-home-request="La Dimora Blu" data-i18n="tourEnd.blu">{t("tourEnd.blu", lang)}</a>
          </div>
          <p class="tour-end-links">
            <a href={url("/galleria-verde", lang)} data-i18n="tourEnd.photosVerde">{t("tourEnd.photosVerde", lang)}</a>
            <span aria-hidden="true">·</span>
            <a href={url("/galleria-blu", lang)} data-i18n="tourEnd.photosBlu">{t("tourEnd.photosBlu", lang)}</a>
          </p>
        </div>
      </section>

      <section class="quick-paths" aria-label="Percorsi rapidi">
        <a href={url("/scopri", lang)}>
          <span data-i18n="quick.touristsLabel">{t("quick.touristsLabel", lang)}</span>
          <strong data-i18n="quick.touristsText">{t("quick.touristsText", lang)}</strong>
        </a>
        <a href="#posizione">
          <span data-i18n="quick.flyLabel">{t("quick.flyLabel", lang)}</span>
          <strong data-i18n="quick.flyText">{t("quick.flyText", lang)}</strong>
        </a>
        <a href="#casa">
          <span data-i18n="quick.groupLabel">{t("quick.groupLabel", lang)}</span>
          <strong data-i18n="quick.groupText">{t("quick.groupText", lang)}</strong>
        </a>
      </section>

      <section id="casa" class="section house-section">
        <div class="section-copy">
          <p class="eyebrow" data-i18n="homes.eyebrow">{t("homes.eyebrow", lang)}</p>
          <h2 data-i18n="homes.title">{t("homes.title", lang)}</h2>
          <p data-i18n="homes.copy">{t("homes.copy", lang)}</p>
        </div>
        <div class="homes-grid">
          <article class="home-card green-home">
            <figure class="home-card-photo">
              <img src="/assets/verde-soggiorno-cucina-08.jpeg" alt="Zona pranzo luminosa della Dimora Verde" loading="lazy" />
            </figure>
            <div class="home-card-top">
              <span data-i18n="homes.green.name">{t("homes.green.name", lang)}</span>
              <small data-i18n="homes.green.meta">{t("homes.green.meta", lang)}</small>
            </div>
            <div class="home-card-main">
              <h3 data-i18n="homes.green.title">{t("homes.green.title", lang)}</h3>
              <p data-i18n="homes.green.copy">{t("homes.green.copy", lang)}</p>
            </div>
            <ul class="home-facts">
              <li data-i18n="homes.green.feature1">{t("homes.green.feature1", lang)}</li>
              <li data-i18n="homes.green.feature3">{t("homes.green.feature3", lang)}</li>
              <li data-i18n="homes.green.feature2">{t("homes.green.feature2", lang)}</li>
            </ul>
            <div class="card-actions">
              <a class="button ghost small" href={url("/galleria-verde", lang)} data-i18n="cta.gallery">{t("cta.gallery", lang)}</a>
              <a class="button primary small" href="#prenota" data-home-request="La Dimora Verde" data-i18n="cta.ask">{t("cta.ask", lang)}</a>
            </div>
          </article>
          <article class="home-card blue-home">
            <figure class="home-card-photo">
              <img src="/assets/blu-soggiorno-cucina-03.jpeg" alt="Soggiorno e cucina della Dimora Blu" loading="lazy" />
            </figure>
            <div class="home-card-top">
              <span data-i18n="homes.blue.name">{t("homes.blue.name", lang)}</span>
              <small data-i18n="homes.blue.meta">{t("homes.blue.meta", lang)}</small>
            </div>
            <div class="home-card-main">
              <h3 data-i18n="homes.blue.title">{t("homes.blue.title", lang)}</h3>
              <p data-i18n="homes.blue.copy">{t("homes.blue.copy", lang)}</p>
            </div>
            <ul class="home-facts">
              <li data-i18n="homes.blue.feature1">{t("homes.blue.feature1", lang)}</li>
              <li data-i18n="homes.blue.feature3">{t("homes.blue.feature3", lang)}</li>
              <li data-i18n="homes.blue.feature2">{t("homes.blue.feature2", lang)}</li>
            </ul>
            <div class="card-actions">
              <a class="button ghost small" href={url("/galleria-blu", lang)} data-i18n="cta.gallery">{t("cta.gallery", lang)}</a>
              <a class="button primary small" href="#prenota" data-home-request="La Dimora Blu" data-i18n="cta.ask">{t("cta.ask", lang)}</a>
            </div>
          </article>
        </div>
      </section>

      <section id="posizione" class="section location-section">
        <div class="map-panel">
          <img src="/assets/location-map-1800.jpeg" alt="Vista dall'alto della posizione in Via Strada Statale Est 157" loading="lazy" />
        </div>
        <div class="timeline" aria-label="Distanze utili">
          <div class="route-card" aria-label="Indicazioni dall'aeroporto alla dimora">
            <div class="route-card-header">
              <span data-i18n="location.routeLabel">{t("location.routeLabel", lang)}</span>
              <strong data-i18n="location.routeTitle">{t("location.routeTitle", lang)}</strong>
              <small data-i18n="location.routeTime">{t("location.routeTime", lang)}</small>
            </div>
            <ol class="route-steps">
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step1Title">{t("location.step1Title", lang)}</b><small data-i18n="location.step1Text">{t("location.step1Text", lang)}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step2Title">{t("location.step2Title", lang)}</b><small data-i18n="location.step2Text">{t("location.step2Text", lang)}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step3Title">{t("location.step3Title", lang)}</b><small data-i18n="location.step3Text">{t("location.step3Text", lang)}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step4Title">{t("location.step4Title", lang)}</b><small data-i18n="location.step4Text">{t("location.step4Text", lang)}</small></p>
              </li>
            </ol>
          </div>
          <div>
            <span data-i18n="location.airportLabel">{t("location.airportLabel", lang)}</span>
            <strong data-i18n="location.airportTitle">{t("location.airportTitle", lang)}</strong>
            <p data-i18n="location.airportText">{t("location.airportText", lang)}</p>
          </div>
          <div>
            <span data-i18n="location.cityLabel">{t("location.cityLabel", lang)}</span>
            <strong data-i18n="location.cityTitle">{t("location.cityTitle", lang)}</strong>
            <p data-i18n="location.cityText">{t("location.cityText", lang)}</p>
          </div>
          <div>
            <span data-i18n="location.seaLabel">{t("location.seaLabel", lang)}</span>
            <strong data-i18n="location.seaTitle">{t("location.seaTitle", lang)}</strong>
            <p data-i18n="location.seaText">{t("location.seaText", lang)}</p>
          </div>
          <div>
            <span data-i18n="location.stationLabel">{t("location.stationLabel", lang)}</span>
            <strong data-i18n="location.stationTitle">{t("location.stationTitle", lang)}</strong>
            <p data-i18n="location.stationText">{t("location.stationText", lang)}</p>
          </div>
        </div>
      </section>

      <section id="servizi" class="section experience-section">
        <div class="section-heading">
          <p class="eyebrow" data-i18n="services.eyebrow">{t("services.eyebrow", lang)}</p>
