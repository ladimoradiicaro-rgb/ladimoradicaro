          <p class="eyebrow" data-i18n="reviews.eyebrow">{t("reviews.eyebrow", lang)}</p>
          <h2 data-i18n="reviews.title">{t("reviews.title", lang)}</h2>
          <p data-i18n="reviews.copy">{t("reviews.copy", lang)}</p>
          <div class="review-actions">
            <a
              class="review-google-link"
              href="https://g.page/r/CfbDviinOJALEBM/review"
              target="_blank"
              rel="noreferrer"
              data-i18n="reviews.googleCta"
            >{t("reviews.googleCta", lang)}</a>
            <a
              class="review-google-link secondary"
              href="https://www.booking.com/Share-p6vU03"
              target="_blank"
              rel="noreferrer"
              data-i18n="reviews.bookingCta"
            >{t("reviews.bookingCta", lang)}</a>
          </div>
        </div>
        <div class="review-marquee" aria-label="Recensioni a 5 stelle in evidenza">
          <div class="review-track">
            <article class="review-card">
              <div class="stars" aria-label="5 stelle">★★★★★</div>
