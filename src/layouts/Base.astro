---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageChrome from "../components/PageChrome.astro";
import { SITE_URL, ASSET_VERSION } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Clean path used for canonical and og:url, e.g. "/" or "/scopri". */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path under /public, e.g. "/assets/hero-soggiorno-2400.jpeg". */
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
  header?: "home" | "page" | "guide" | "policy";
  /** Stylesheets from /public, loaded in this order. */
  styles?: string[];
  /** Classic scripts from /public, loaded with defer in this order. */
  scripts?: string[];
  /** JSON-LD object(s) rendered as <script type="application/ld+json">. */
  jsonLd?: object | object[];
  /** Footer, floating WhatsApp, cookie banner and lightbox. */
  chrome?: boolean;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  noindex = false,
  bodyClass,
  header = "page",
  styles = ["styles.css", "motion.css", "polish.css"],
  scripts = [],
  jsonLd,
  chrome = true,
} = Astro.props;

const canonical = new URL(path, SITE_URL).toString().replace(/\/$/, path === "/" ? "/" : "");
const v = (file: string) => `/${file}?v=${ASSET_VERSION}`;
// Classic scripts that switch IT/EN need the shared dictionaries first.
const needsI18n = scripts.some((file) => file === "script.js" || file === "scopri.js");
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:url" content={canonical} />
        {ogImage && <meta property="og:image" content={new URL(ogImage, SITE_URL).toString()} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href="/assets/logo-originale.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    {[...styles, "motion-system.css"].map((file) => <link rel="stylesheet" href={v(file)} />)}
    {needsI18n && <script is:inline defer src={v("i18n.js")}></script>}
    {scripts.map((file) => <script is:inline defer src={file.startsWith("vendor/") ? `/${file}` : v(file)}></script>)}
    {ldBlocks.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data, null, 2)} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header variant={header} />
    <slot />
    {chrome && <Footer />}
    <slot name="after" />
    {chrome && <PageChrome />}

  </body>
</html>
