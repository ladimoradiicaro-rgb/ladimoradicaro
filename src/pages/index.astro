---
import { t } from "../i18n";
import Base from "../layouts/Base.astro";
import HouseTour from "../components/react/HouseTour";
import BookingForm from "../components/react/BookingForm";
import jsonLd from "../data/jsonld/index.json";
---
<Base
  title="La Dimora di Icaro | Case vacanza tra Palermo, mare e aeroporto"
  description="La Dimora di Icaro: due case vacanza familiari a Carini, tra Palermo, mare e aeroporto Falcone Borsellino. Verifica disponibilità per Dimora Verde e Dimora Blu."
  path="/"
  header="home"
  ogDescription="Due dimore familiari a Carini, comode per Palermo, la spiaggia di Capaci e l'aeroporto Falcone Borsellino."
  ogImage="/assets/hero-soggiorno-2400.jpeg"
  scripts={["vendor/lenis/lenis.min.js", "script.js", "motion.js"]}
  jsonLd={jsonLd}
>
  <main id="home">
      <!-- Hero temporaneamente nascosto: il tour a tutto schermo apre la pagina. Rimuovere "hidden" per ripristinarlo. -->
      <section class="hero" aria-label="Benvenuto" hidden>
        <div class="hero-media" role="img" aria-label="Casa siciliana luminosa e accogliente"></div>
        <div class="hero-content">
          <p class="eyebrow" data-i18n="hero.eyebrow">{t("hero.eyebrow")}</p>
          <p class="hero-title" data-i18n="hero.title">{t("hero.title")}</p>
          <p class="licence-note">CIN IT082021C23NRN5DBU - CIR 19082021C259979</p>
          <div class="hero-actions">
            <a class="button primary" href="#prenota" data-i18n="cta.check">{t("cta.check")}</a>
            <a class="button ghost" href="/scopri" data-i18n="cta.guide">{t("cta.guide")}</a>
          </div>
        </div>
        <aside class="arrival-card" aria-label="Punti forti">
          <span data-i18n="hero.cardLabel">{t("hero.cardLabel")}</span>
          <strong data-i18n="hero.cardText">{t("hero.cardText")}</strong>
          <div class="arrival-grid">
            <p><b>12 min</b><small data-i18n="hero.airportSmall">{t("hero.airportSmall")}</small></p>
            <p><b>600 m</b><small data-i18n="hero.stationSmall">{t("hero.stationSmall")}</small></p>
          </div>
        </aside>
      </section>

      <section id="tour" class="tour-section" aria-labelledby="tour-title">
        <div class="tour-intro visually-hidden">
          <h1 data-i18n="hero.title">{t("hero.title")}</h1>
          <p class="eyebrow" data-i18n="tour.eyebrow">{t("tour.eyebrow")}</p>
          <h2 id="tour-title" data-i18n="tour.title">{t("tour.title")}</h2>
          <p data-i18n="tour.copy">{t("tour.copy")}</p>
        </div>
        <HouseTour client:load />
      </section>

      <section id="tour-fine" class="tour-end" aria-labelledby="tour-end-title">
        <div class="tour-end-media" aria-hidden="true">
          <img src="/assets/tour/verde-esterni-05-1280.webp" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="tour-end-inner">
          <h2 id="tour-end-title" data-i18n="tourEnd.title">{t("tourEnd.title")}</h2>
          <div class="tour-end-actions">
            <a class="tour-end-btn tour-end-btn--verde" href="#prenota" data-home-request="La Dimora Verde" data-i18n="tourEnd.verde">{t("tourEnd.verde")}</a>
            <a class="tour-end-btn tour-end-btn--blu" href="#prenota" data-home-request="La Dimora Blu" data-i18n="tourEnd.blu">{t("tourEnd.blu")}</a>
          </div>
          <p class="tour-end-links">
            <a href="/galleria-verde" data-i18n="tourEnd.photosVerde">{t("tourEnd.photosVerde")}</a>
            <span aria-hidden="true">·</span>
            <a href="/galleria-blu" data-i18n="tourEnd.photosBlu">{t("tourEnd.photosBlu")}</a>
          </p>
        </div>
      </section>

      <section class="quick-paths" aria-label="Percorsi rapidi">
        <a href="/scopri">
          <span data-i18n="quick.touristsLabel">{t("quick.touristsLabel")}</span>
          <strong data-i18n="quick.touristsText">{t("quick.touristsText")}</strong>
        </a>
        <a href="#posizione">
          <span data-i18n="quick.flyLabel">{t("quick.flyLabel")}</span>
          <strong data-i18n="quick.flyText">{t("quick.flyText")}</strong>
        </a>
        <a href="#casa">
          <span data-i18n="quick.groupLabel">{t("quick.groupLabel")}</span>
          <strong data-i18n="quick.groupText">{t("quick.groupText")}</strong>
        </a>
      </section>

      <section id="casa" class="section house-section">
        <div class="section-copy">
          <p class="eyebrow" data-i18n="homes.eyebrow">{t("homes.eyebrow")}</p>
          <h2 data-i18n="homes.title">{t("homes.title")}</h2>
          <p data-i18n="homes.copy">{t("homes.copy")}</p>
        </div>
        <div class="homes-grid">
          <article class="home-card green-home">
            <figure class="home-card-photo">
              <img src="/assets/verde-soggiorno-cucina-08.jpeg" alt="Zona pranzo luminosa della Dimora Verde" loading="lazy" />
            </figure>
            <div class="home-card-top">
              <span data-i18n="homes.green.name">{t("homes.green.name")}</span>
              <small data-i18n="homes.green.meta">{t("homes.green.meta")}</small>
            </div>
            <div class="home-card-main">
              <h3 data-i18n="homes.green.title">{t("homes.green.title")}</h3>
              <p data-i18n="homes.green.copy">{t("homes.green.copy")}</p>
            </div>
            <ul class="home-facts">
              <li data-i18n="homes.green.feature1">{t("homes.green.feature1")}</li>
              <li data-i18n="homes.green.feature3">{t("homes.green.feature3")}</li>
              <li data-i18n="homes.green.feature2">{t("homes.green.feature2")}</li>
            </ul>
            <div class="card-actions">
              <a class="button ghost small" href="/galleria-verde" data-i18n="cta.gallery">{t("cta.gallery")}</a>
              <a class="button primary small" href="#prenota" data-home-request="La Dimora Verde" data-i18n="cta.ask">{t("cta.ask")}</a>
            </div>
          </article>
          <article class="home-card blue-home">
            <figure class="home-card-photo">
              <img src="/assets/blu-soggiorno-cucina-03.jpeg" alt="Soggiorno e cucina della Dimora Blu" loading="lazy" />
            </figure>
            <div class="home-card-top">
              <span data-i18n="homes.blue.name">{t("homes.blue.name")}</span>
              <small data-i18n="homes.blue.meta">{t("homes.blue.meta")}</small>
            </div>
            <div class="home-card-main">
              <h3 data-i18n="homes.blue.title">{t("homes.blue.title")}</h3>
              <p data-i18n="homes.blue.copy">{t("homes.blue.copy")}</p>
            </div>
            <ul class="home-facts">
              <li data-i18n="homes.blue.feature1">{t("homes.blue.feature1")}</li>
              <li data-i18n="homes.blue.feature3">{t("homes.blue.feature3")}</li>
              <li data-i18n="homes.blue.feature2">{t("homes.blue.feature2")}</li>
            </ul>
            <div class="card-actions">
              <a class="button ghost small" href="/galleria-blu" data-i18n="cta.gallery">{t("cta.gallery")}</a>
              <a class="button primary small" href="#prenota" data-home-request="La Dimora Blu" data-i18n="cta.ask">{t("cta.ask")}</a>
            </div>
          </article>
        </div>
      </section>

      <section id="posizione" class="section location-section">
        <div class="map-panel">
          <img src="/assets/location-map-1800.jpeg" alt="Vista dall'alto della posizione in Via Strada Statale Est 157" loading="lazy" />
        </div>
        <div class="timeline" aria-label="Distanze utili">
          <div class="route-card" aria-label="Indicazioni dall'aeroporto alla dimora">
            <div class="route-card-header">
              <span data-i18n="location.routeLabel">{t("location.routeLabel")}</span>
              <strong data-i18n="location.routeTitle">{t("location.routeTitle")}</strong>
              <small data-i18n="location.routeTime">{t("location.routeTime")}</small>
            </div>
            <ol class="route-steps">
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step1Title">{t("location.step1Title")}</b><small data-i18n="location.step1Text">{t("location.step1Text")}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step2Title">{t("location.step2Title")}</b><small data-i18n="location.step2Text">{t("location.step2Text")}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step3Title">{t("location.step3Title")}</b><small data-i18n="location.step3Text">{t("location.step3Text")}</small></p>
              </li>
              <li>
                <span class="route-icon" aria-hidden="true"></span>
                <p><b data-i18n="location.step4Title">{t("location.step4Title")}</b><small data-i18n="location.step4Text">{t("location.step4Text")}</small></p>
              </li>
            </ol>
          </div>
          <div>
            <span data-i18n="location.airportLabel">{t("location.airportLabel")}</span>
            <strong data-i18n="location.airportTitle">{t("location.airportTitle")}</strong>
            <p data-i18n="location.airportText">{t("location.airportText")}</p>
          </div>
          <div>
            <span data-i18n="location.cityLabel">{t("location.cityLabel")}</span>
            <strong data-i18n="location.cityTitle">{t("location.cityTitle")}</strong>
            <p data-i18n="location.cityText">{t("location.cityText")}</p>
          </div>
          <div>
            <span data-i18n="location.seaLabel">{t("location.seaLabel")}</span>
            <strong data-i18n="location.seaTitle">{t("location.seaTitle")}</strong>
            <p data-i18n="location.seaText">{t("location.seaText")}</p>
          </div>
          <div>
            <span data-i18n="location.stationLabel">{t("location.stationLabel")}</span>
            <strong data-i18n="location.stationTitle">{t("location.stationTitle")}</strong>
            <p data-i18n="location.stationText">{t("location.stationText")}</p>
          </div>
        </div>
      </section>

      <section id="servizi" class="section experience-section">
        <div class="section-heading">
          <p class="eyebrow" data-i18n="services.eyebrow">{t("services.eyebrow")}</p>
          <h2 data-i18n="services.title">{t("services.title")}</h2>
