          <article>
            <strong data-i18n="direct.b4.title">{t("direct.b4.title")}</strong>
            <p data-i18n="direct.b4.text">{t("direct.b4.text")}</p>
          </article>
          <article>
            <strong data-i18n="direct.b5.title">{t("direct.b5.title")}</strong>
            <p data-i18n="direct.b5.text">{t("direct.b5.text")}</p>
          </article>
        </div>
      </section>

      <section id="recensioni" class="section review-section" aria-label="Recensioni degli ospiti">
        <div class="section-copy review-copy">
          <p class="eyebrow" data-i18n="reviews.eyebrow">{t("reviews.eyebrow")}</p>
