                <article class="tour-caption is-active" data-tour-caption>
                  <p class="tour-kicker"><span data-i18n="homes.green.name">La Dimora Verde</span></p>
                  <h3 data-i18n="tour.v1.room">Veranda</h3>
                </article>
                <article class="tour-caption" data-tour-caption>
                  <p class="tour-kicker"><span data-i18n="homes.green.name">La Dimora Verde</span></p>
                  <h3 data-i18n="tour.v2.room">Soggiorno</h3>
