      <section id="tour-fine" class="tour-end" aria-labelledby="tour-end-title">
        <div class="tour-end-media" aria-hidden="true">
          <img src="/assets/tour/verde-esterni-05-1280.webp" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="tour-end-inner">
          <h2 id="tour-end-title" data-i18n="tourEnd.title">Ti aspettiamo.</h2>
          <div class="tour-end-actions">
            <a class="tour-end-btn tour-end-btn--verde" href="#prenota" data-home-request="La Dimora Verde" data-i18n="tourEnd.verde">Prenota la Dimora Verde</a>
            <a class="tour-end-btn tour-end-btn--blu" href="#prenota" data-home-request="La Dimora Blu" data-i18n="tourEnd.blu">Prenota la Dimora Blu</a>
          </div>
          <p class="tour-end-links">
            <a href="/galleria-verde" data-i18n="tourEnd.photosVerde">Tutte le foto della Verde</a>
            <span aria-hidden="true">·</span>
            <a href="/galleria-blu" data-i18n="tourEnd.photosBlu">Tutte le foto della Blu</a>
          </p>
        </div>
      </section>

      <section class="quick-paths" aria-label="Percorsi rapidi">
        <a href="/scopri">
          <span data-i18n="quick.touristsLabel">Per turisti</span>
          <strong data-i18n="quick.touristsText">Guida locale con mare, Palermo, ristoranti e servizi vicini.</strong>
        </a>
        <a href="#posizione">
          <span data-i18n="quick.flyLabel">Per chi vola</span>
          <strong data-i18n="quick.flyText">A 12 minuti dall'aeroporto, comoda prima o dopo il volo.</strong>
        </a>
        <a href="#casa">
          <span data-i18n="quick.groupLabel">Per ogni gruppo</span>
          <strong data-i18n="quick.groupText">Dimora Verde fino a 7 ospiti, Dimora Blu fino a 4, con limiti adulti dedicati.</strong>
        </a>
      </section>

      <section id="casa" class="section house-section">
        <div class="section-copy">
          <p class="eyebrow" data-i18n="homes.eyebrow">Le due case</p>
          <h2 data-i18n="homes.title">Scegli la dimora più adatta al tuo modo di viaggiare.</h2>
          <p data-i18n="homes.copy">
            La Dimora di Icaro nasce per accogliere famiglie, coppie e piccoli gruppi con una sensazione semplice:
            arrivare, posare le valigie e trovare una casa vera, curata e pronta.
          </p>
        </div>
        <div class="homes-grid">
          <article class="home-card green-home">
            <figure class="home-card-photo">
              <img src="/assets/verde-soggiorno-cucina-08.jpeg" alt="Zona pranzo luminosa della Dimora Verde" loading="lazy" />
            </figure>
            <div class="home-card-top">
              <span data-i18n="homes.green.name">La Dimora Verde</span>
              <small data-i18n="homes.green.meta">105 mq · fino a 7 ospiti · max 5 adulti</small>
            </div>
