                <figure class="tour-shot" data-tour-shot data-room="5"><img src="/assets/tour/verde-bagni-04-1920.webp" srcset="/assets/tour/verde-bagni-04-1280.webp 1280w, /assets/tour/verde-bagni-04-1920.webp 1920w" sizes="(orientation: portrait) 150vh, 100vw" alt="Bagni della Dimora Verde, foto 3 di 3" loading="lazy" decoding="async" /></figure>
              </div>
              <div class="tour-veil" aria-hidden="true"></div>
              <div class="tour-logo" aria-hidden="true">
                <img src="/assets/logo-site-web.png" alt="" fetchpriority="high" />
              </div>
              <header class="tour-head">
                <span class="tour-count"><b data-tour-current>01</b> / 06</span>
              </header>
              <div class="tour-progress" aria-hidden="true"><i data-tour-seg><b></b></i><i data-tour-seg><b></b></i><i data-tour-seg><b></b></i><i data-tour-seg><b></b></i><i data-tour-seg><b></b></i><i data-tour-seg><b></b></i></div>
