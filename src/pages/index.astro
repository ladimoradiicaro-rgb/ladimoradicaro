---
import Base from "../layouts/Base.astro";
import jsonLd from "../data/jsonld/index.json";
---
<Base
  title="La Dimora di Icaro | Case vacanza tra Palermo, mare e aeroporto"
  description="La Dimora di Icaro: due case vacanza familiari a Carini, tra Palermo, mare e aeroporto Falcone Borsellino. Verifica disponibilità per Dimora Verde e Dimora Blu."
  path="/"
  header="home"
  ogDescription="Due dimore familiari a Carini, comode per Palermo, la spiaggia di Capaci e l'aeroporto Falcone Borsellino."
  ogImage="/assets/hero-soggiorno-2400.jpeg"
  scripts={["vendor/lenis/lenis.min.js", "script.js", "motion.js", "tour.js"]}
  jsonLd={jsonLd}
>
  <main id="home">
      <!-- Hero temporaneamente nascosto: il tour a tutto schermo apre la pagina. Rimuovere "hidden" per ripristinarlo. -->
      <section class="hero" aria-label="Benvenuto" hidden>
        <div class="hero-media" role="img" aria-label="Casa siciliana luminosa e accogliente"></div>
        <div class="hero-content">
          <p class="eyebrow" data-i18n="hero.eyebrow">Tra Palermo, mare e aeroporto</p>
          <p class="hero-title" data-i18n="hero.title">Due dimore familiari tra Palermo, mare e aeroporto.</p>
          <p class="licence-note">CIN IT082021C23NRN5DBU - CIR 19082021C259979</p>
          <div class="hero-actions">
            <a class="button primary" href="#prenota" data-i18n="cta.check">Verifica disponibilità</a>
            <a class="button ghost" href="/scopri" data-i18n="cta.guide">Apri la guida locale</a>
          </div>
        </div>
        <aside class="arrival-card" aria-label="Punti forti">
          <span data-i18n="hero.cardLabel">Arrivo semplice</span>
          <strong data-i18n="hero.cardText">Check-in dalle 15:00, casa pronta e collegamenti rapidi.</strong>
          <div class="arrival-grid">
            <p><b>12 min</b><small data-i18n="hero.airportSmall">dall'aeroporto</small></p>
            <p><b>600 m</b><small data-i18n="hero.stationSmall">dalla stazione</small></p>
          </div>
        </aside>
      </section>

      <section id="tour" class="tour-section" aria-labelledby="tour-title">
        <div class="tour-intro visually-hidden">
          <h1 data-i18n="hero.title">Due dimore familiari tra Palermo, mare e aeroporto.</h1>
          <p class="eyebrow" data-i18n="tour.eyebrow">Tour delle dimore</p>
          <h2 id="tour-title" data-i18n="tour.title">Entra e guardati intorno, una stanza alla volta.</h2>
          <p data-i18n="tour.copy">Scorri per fare il giro completo: prima la Dimora Verde, poi la Dimora Blu.</p>
        </div>
        <div class="tour tour--verde" id="foto-verde" data-tour data-tour-lead="2" style="--frames: 20">
          <div class="tour-stage">
            <div class="tour-frame">
              <div class="tour-shots">
                <figure class="tour-shot" data-tour-shot data-room="0"><img src="/assets/tour/verde-esterni-05-1920.webp" srcset="/assets/tour/verde-esterni-05-1280.webp 1280w, /assets/tour/verde-esterni-05-1920.webp 1920w" sizes="(orientation: portrait) 150vh, 100vw" alt="Veranda coperta della Dimora Verde, foto 1 di 3" decoding="async" fetchpriority="high" /></figure>
                <figure class="tour-shot" data-tour-shot data-room="0"><img src="/assets/tour/verde-esterni-04-1920.webp" srcset="/assets/tour/verde-esterni-04-1280.webp 1280w, /assets/tour/verde-esterni-04-1920.webp 1920w" sizes="(orientation: portrait) 150vh, 100vw" alt="Veranda coperta della Dimora Verde, foto 2 di 3" loading="lazy" decoding="async" /></figure>
                <figure class="tour-shot" data-tour-shot data-room="0"><img src="/assets/tour/verde-esterni-06-1920.webp" srcset="/assets/tour/verde-esterni-06-1280.webp 1280w, /assets/tour/verde-esterni-06-1920.webp 1920w" sizes="(orientation: portrait) 150vh, 100vw" alt="Veranda coperta della Dimora Verde, foto 3 di 3" loading="lazy" decoding="async" /></figure>
